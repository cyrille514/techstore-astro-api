---
// src/components/Header.astro
---

<header class="bg-white border-b border-slate-200 sticky top-0 z-30">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
    <div class="flex items-center gap-3">
      <div class="bg-indigo-600 text-white p-2 rounded-xl text-lg font-black shadow-md shadow-indigo-600/20">
        ⚡
      </div>
      <div>
        <h1 class="font-extrabold text-slate-900 text-sm sm:text-base leading-tight">TechStore API</h1>
        <p class="text-[10px] text-slate-400 font-semibold">Panel E-Commerce & Control de Stock</p>
      </div>
    </div>

    <button 
      id="open-product-modal-btn" 
      class="bg-indigo-600 hover:bg-indigo-700 text-white text-xs font-bold px-3.5 py-2 rounded-xl transition-all flex items-center gap-1.5 shadow-md shadow-indigo-600/20"
    >
      <span>＋</span> <span class="hidden sm:inline">Nuevo Producto</span>
    </button>
  </div>
</header>